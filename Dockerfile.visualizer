FROM python:3.11-slim

WORKDIR /app

# Dependencias del sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Copiar requirements.txt (se mantiene para referencia, pero no se usa en la instalación)
COPY requirements.txt .

# Instalación en un solo paso con TODAS las versiones compatibles
# Capa 1: dependencias base
RUN pip install --no-cache-dir \
    langchain-core==0.2.43 \
    langchain==0.2.17 \
    langchain-openai==0.1.25 \
    langchain-community==0.2.19 \
    "langsmith<0.2.0"

# Capa 2: langgraph y checkpoint
RUN pip install --no-cache-dir \
    langgraph==0.2.56 \
    langgraph-checkpoint==2.0.5 \
    langgraph-checkpoint-postgres==2.0.5

# Capa 3: CLI
RUN pip install --no-cache-dir \
    langgraph-cli[inmem]==0.1.18

# Copiar el código fuente
COPY . .

# Puerto
ENV PORT=8080
EXPOSE 8080

# Comando de inicio
CMD ["sh", "-c", "langgraph dev --host 0.0.0.0 --port ${PORT:-8080} --no-browser"]
