FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Instalación de dependencias: solo lo necesario
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        "langgraph-cli[inmem]>=0.4.31" \
        langchain-core==0.2.43 \
        langchain==0.2.17 \
        langgraph==0.2.56 \
        langchain-openai==0.1.25 \
        langchain-community==0.2.19 \
        "langsmith<0.2.0" \
        langgraph-checkpoint==2.0.7 \
        langgraph-checkpoint-postgres==2.0.7 \
        openai>=1.50.0 \
        psycopg2-binary==2.9.9 \
        "psycopg[binary]>=3.1.4" \
        sqlalchemy==2.0.31 \
        asyncpg==0.29.0 \
        requests==2.32.3 \
        python-dotenv==1.0.1 \
        pydantic==2.7.4 \
        httpx==0.27.2 \
        psutil==5.9.8 \
        google-auth==2.30.0 \
        google-auth-oauthlib==1.2.0 \
        google-api-python-client==2.198.0 \
        symspellpy==6.7.0 \
        rapidfuzz==3.0.0 \
        redis==5.0.0

COPY . .

ENV PORT=8080
EXPOSE 8080

# Comando correcto
CMD ["sh", "-c", "langgraph dev --host 0.0.0.0 --port ${PORT:-8080} --no-browser"]
