# DOCUMENTACIÓN DE AUDITORÍA ISO/IEC 25010
# Componente: Jarvi Studio Visualizer
# ==============================================================================

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "langgraph-cli[inmem]" \
    && pip install --no-cache-dir uvicorn

COPY . .

EXPOSE 8080

CMD ["sh", "-c", "python -m langgraph_api.cli --host 0.0.0.0 --port ${PORT:-8080} --config langgraph.json"]
