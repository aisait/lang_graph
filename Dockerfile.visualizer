# ==============================================================================
# DOCUMENTACIÓN DE AUDITORÍA ISO/IEC 25010
# Componente: Jarvi Studio Visualizer
# Justificación Técnica: 
# - Aislamiento: Imagen 'slim' para minimizar la superficie de ataque y optimizar recursos.
# - Portabilidad: Entorno determinista para consistencia en CI/CD.
# - Fiabilidad: Instalación explícita de CLI para asegurar disponibilidad de comandos.
# ==============================================================================

# CORRECCIÓN: Paridad de runtime con producción (3.11 en lugar de 3.12) para evitar colisiones
FROM python:3.11-slim

LABEL maintainer="AISA Solar - Equipo de Ingeniería"
LABEL description="Servidor dedicado para LangGraph Studio Visualizer."
LABEL service="visualizer"
LABEL compliance="ISO/IEC-25010-Ready"

WORKDIR /app

# ----------------------------------------------------------------------
# Configuración del entorno
# ----------------------------------------------------------------------
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="/usr/local/bin:${PATH}"

# INYECCIÓN EPISTEMOLÓGICA (Dummy Environment)
# Aísla el visualizador forzando el bypass de validadores ISO y bases de datos reales.
ENV IS_BACKEND="False"
ENV DATABASE_URL="sqlite:///:memory:"
ENV OPENAI_API_KEY="sk-dummy-key-for-visualizer-only"

# CORRECCIÓN: Permitir todos los orígenes para LangGraph Studio (CORS)
ENV LANGGRAPH_ALLOWED_ORIGINS="*"

# ----------------------------------------------------------------------
# Instalación de dependencias
# ----------------------------------------------------------------------

# Add this line to force a rebuild
ARG REFRESH_DATE=2026-07-07

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Instalación optimizada:
# 1. Actualizamos pip.
# 2. Instalamos dependencias generales.
# 3. Forzamos la instalación de langgraph-cli[inmem].
# 4. Verificamos la existencia del binario en los logs del build.

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir google-auth && \
    pip install --no-cache-dir --force-reinstall "langgraph-cli[inmem]" && \
    which langgraph

COPY . .

# ----------------------------------------------------------------------
# Ejecución
# CORRECCIÓN: Se añade --allowed-origins '*' para permitir conexiones desde Studio.
# ----------------------------------------------------------------------
EXPOSE 8080

CMD ["sh", "-c", "python -m langgraph_api.cli --host 0.0.0.0 --port ${PORT:-8080} --allowed-origins '*'"]
