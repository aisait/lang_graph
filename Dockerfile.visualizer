# Dockerfile.visualizer
# Propósito: Imagen de contenedor aislada para JARVI Studio Visualizer (LangGraph CLI).
# Estándares aplicados: ISO/IEC 25010 (Aislamiento de recursos y Portabilidad).

# ----------------------------------------------------------------------
# Capa base: Python 3.12 slim, alineada con el runtime original del Visualizador
# ----------------------------------------------------------------------
FROM python:3.12-slim

LABEL maintainer="AISA Solar - Equipo de Ingeniería"
LABEL description="Servidor dedicado para LangGraph Studio Visualizer. Aislado de la API central."
LABEL service="visualizer"

WORKDIR /app

# ----------------------------------------------------------------------
# Instalación de dependencias del sistema operativo base
# ----------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------
# Prevención de caché y control de bytecode
# ----------------------------------------------------------------------
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# ----------------------------------------------------------------------
# Gestión de dependencias
# Se fuerza la instalación explícita de langgraph-cli para asegurar
# que el binario principal esté disponible en el entorno global del contenedor.
# ----------------------------------------------------------------------
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt langgraph-cli --upgrade

COPY . .

# ----------------------------------------------------------------------
# Exposición de puerto dinámico
# ----------------------------------------------------------------------
EXPOSE 8080

# ----------------------------------------------------------------------
# Entrypoint determinístico usando el módulo de Python
# ----------------------------------------------------------------------
CMD ["sh", "-c", "python -m langgraph dev --host 0.0.0.0 --port ${PORT:-8080}"]
