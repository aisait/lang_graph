FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Capa 1: Frameworks web
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        fastapi==0.115.0 \
        uvicorn[standard]==0.30.1 \
        python-multipart==0.0.9 \
        Flask==2.2.0

# Capa 2: LangChain
RUN pip install --no-cache-dir \
        langchain==0.2.17 \
        langchain-core==0.2.43 \
        langchain-openai==0.1.25 \
        langchain-community==0.2.19 \
        openai==1.50.0 \
        "langsmith<0.2.0"

# Capa 3: LangGraph (versiones compatibles)
RUN pip install --no-cache-dir \
        langgraph==0.2.56 \
        langgraph-checkpoint==2.0.7 \
        langgraph-checkpoint-postgres==2.0.7

# Capa 4: CLI
RUN pip install --no-cache-dir \
        langgraph-cli[inmem]==0.1.18

# Capa 5: Otras dependencias
RUN pip install --no-cache-dir \
        psycopg2-binary==2.9.9 \
        "psycopg[binary]>=3.1.4" \
        sqlalchemy==2.0.31 \
        asyncpg==0.29.0 \
        requests==2.32.3 \
        python-dotenv==1.0.1 \
        pydantic==2.7.4 \
        httpx==0.27.2 \
        psutil==5.9.8 \
        google-auth==2.30.0 \
        google-auth-oauthlib==1.2.0 \
        google-api-python-client==2.198.0 \
        symspellpy==6.7.0 \
        rapidfuzz==3.0.0 \
        redis==5.0.0

COPY . .

ENV PORT=8080
EXPOSE 8080

# COMANDO CORREGIDO: sin --host
CMD ["sh", "-c", "langgraph up --port ${PORT:-8080}"]
