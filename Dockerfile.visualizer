FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Copiar el archivo de dependencias específico del visualizer
COPY requirements-visualizer.txt .

# Instalar dependencias (sin usar el requirements.txt del backend)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-visualizer.txt

# Copiar el código fuente (studio_graph.py, langgraph.json, etc.)
COPY . .

ENV PORT=8080
EXPOSE 8080

# Comando correcto: langgraph dev (NO usa Docker)
CMD ["sh", "-c", "langgraph dev --host 0.0.0.0 --port ${PORT:-8080} --no-browser"]
