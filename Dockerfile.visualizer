FROM python:3.11-slim

LABEL maintainer="AISA Solar - Equipo de Ingeniería"
LABEL description="Servidor dedicado para LangGraph Studio Visualizer."
LABEL service="visualizer"
LABEL compliance="ISO/IEC-25010-Ready"

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="/usr/local/bin:${PATH}"
ENV IS_BACKEND="False"
ENV DATABASE_URL="sqlite:///:memory:"
ENV OPENAI_API_KEY="sk-dummy-key-for-visualizer-only"
ENV LANGGRAPH_ALLOWED_ORIGINS="*"

ARG REFRESH_DATE=2026-07-07

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Instalación con versiones compatibles
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir google-auth google-auth-oauthlib && \
    pip install --no-cache-dir "langgraph-cli[inmem]>=0.1.0" && \
    pip install --no-cache-dir "langgraph-api>=0.0.1" && \
    pip install --no-cache-dir "langgraph-runtime-inmem>=0.0.1" && \
    which langgraph

COPY . .

EXPOSE 8080

# Comando de arranque: usa langgraph dev con --no-reload
CMD ["sh", "-c", "langgraph dev --host 0.0.0.0 --port ${PORT:-8080} --no-reload"]
