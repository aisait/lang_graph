FROM python:3.11-slim

WORKDIR /app

# Instala dependencias del sistema (necesarias para algunas librerías)
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copia e instala dependencias de Python
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --upgrade "langgraph-cli[inmem]" "langgraph-runtime-inmem" && \
    pip install --no-cache-dir --upgrade langgraph-api langgraph-checkpoint

# Copia el resto del código
COPY . .

# Puerto de escucha
ENV PORT=8080
EXPOSE 8080

# Comando: langgraph dev (entorno de desarrollo, pero funciona en producción)
CMD ["sh", "-c", "langgraph dev --host 0.0.0.0 --port ${PORT:-8080} --no-browser"]
