# ==============================================================================
# DOCUMENTACIÓN DE AUDITORÍA ISO/IEC 25010
# Componente: Jarvi Studio Visualizer
# Justificación Técnica: 
# - Aislamiento: Imagen 'slim' para minimizar la superficie de ataque y optimizar recursos.
# - Portabilidad: Entorno determinista para consistencia en CI/CD.
# - Fiabilidad: Instalación explícita de CLI para asegurar disponibilidad de comandos.
# ==============================================================================

FROM python:3.12-slim

LABEL maintainer="AISA Solar - Equipo de Ingeniería"
LABEL description="Servidor dedicado para LangGraph Studio Visualizer."
LABEL service="visualizer"
LABEL compliance="ISO/IEC-25010-Ready"

WORKDIR /app

# ----------------------------------------------------------------------
# Configuración del entorno
# ----------------------------------------------------------------------
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="/usr/local/bin:${PATH}"

# ----------------------------------------------------------------------
# Instalación de dependencias
# ----------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Instalación optimizada:
# 1. Actualizamos pip.
# 2. Instalamos dependencias generales.
# 3. Forzamos la instalación de langgraph-cli[inmem].
# 4. Verificamos la existencia del binario en los logs del build.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --force-reinstall "langgraph-cli[inmem]" && \
    which langgraph

COPY . .

# ----------------------------------------------------------------------
# Ejecución
# ----------------------------------------------------------------------
EXPOSE 8080

# Usamos sh -c para asegurar la expansión de variables de entorno (${PORT})
CMD ["sh", "-c", "langgraph dev --host 0.0.0.0 --port ${PORT:-8080}"]
