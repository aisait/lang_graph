FROM python:3.11-slim

WORKDIR /app

# Dependencias del sistema necesarias para compilar librerías de IA y Postgres
RUN apt-get update && apt-get install -y gcc libpq-dev && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Exposición dinámica de puertos
EXPOSE 8080

# MITIGACIÓN OOM KILLER: 
# Se utiliza un solo worker (--workers 1) para consolidar la memoria del modelo.
# Se incrementa el timeout-keep-alive para soportar la latencia de inferencia.
CMD ["sh", "-c", "uvicorn api_server:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1 --timeout-keep-alive 120"]
