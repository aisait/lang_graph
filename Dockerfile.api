# =============================================================================
# JARVI 2.0.18 | Dockerfile.api VERSIÓN FINAL
# =============================================================================

ARG CACHE_BUST=20260727_FINAL_V2

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libstdc++6 \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN echo "Cache bust version: ${CACHE_BUST}"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

RUN python -c "import langfuse, asyncpg, redis; print('✅ Dependencias críticas OK')"

COPY . .

# =============================================================================
# ELIMINAR TODOS LOS ARCHIVOS OBSOLETOS Y LIMPIAR CACHÉ
# =============================================================================
RUN rm -f /app/api.py /app/api_server.py /app/api_buffer.py /app/api_new.py 2>/dev/null || true
RUN find . -type d -name __pycache__ -exec rm -rf {} + || true

# =============================================================================
# VERIFICACIÓN (SOLO DEBE EXISTIR api_v2.py)
# =============================================================================
RUN ls -la /app/api*.py && \
    grep -q "🔍 Respuesta final:" /app/api_v2.py && echo "✅ api_v2.py contiene diagnóstico" || echo "❌ api_v2.py NO contiene diagnóstico" && \
    grep -q "ON CONFLICT (thread_id)" /app/db_client.py && echo "✅ db_client.py tiene UPSERT" || echo "❌ db_client.py antiguo" && \
    grep -q "===== JARVI API" /app/api_v2.py && echo "✅ api_v2.py tiene print de inicio" || echo "❌ api_v2.py sin print"

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import langfuse, asyncpg, redis" || exit 1

EXPOSE 8080

# =============================================================================
# PUNTO DE ENTRADA CON NOMBRE NUEVO Y ÚNICO
# =============================================================================
CMD ["uvicorn", "api_v2:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
