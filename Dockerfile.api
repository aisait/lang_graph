FROM python:3.11-slim

# Dependencias del sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 libgcc-s1 build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Instalar dependencias Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --force-reinstall "langfuse>=2.0.0" "packaging==24.2"

# Verificación inmediata
RUN python -c "import langfuse; print(f'Langfuse {langfuse.__version__} OK')"

COPY . .

# Health check que verifica dependencias críticas
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import langfuse, asyncpg, redis; print('OK')" || exit 1

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
