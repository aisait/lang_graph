# =============================================================================
# JARVI 2.0.19 | Dockerfile.api – Adaptador REST
# =============================================================================
ARG CACHE_BUST=20260728_REST_FINAL

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libstdc++6 \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN echo "Cache bust version: ${CACHE_BUST}"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

RUN python -c "import asyncpg, redis, openai, requests; print('✅ Dependencias OK')"

COPY . .

RUN rm -f /app/api.py /app/api_server.py /app/api_buffer.py 2>/dev/null || true
RUN find . -type d -name __pycache__ -exec rm -rf {} + || true

RUN grep -q "ObservabilityPort" /app/observability.py && echo "✅ observability.py OK" || echo "❌ observability.py falta"
RUN grep -q "LangfuseRESTAdapter" /app/observability.py && echo "✅ adaptador REST presente" || echo "❌ adaptador REST ausente"
RUN grep -q "get_observability_adapter" /app/api_v2.py && echo "✅ api_v2.py usa adaptador" || echo "❌ api_v2.py sin adaptador"

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import asyncpg, redis" || exit 1

EXPOSE 8080

CMD ["uvicorn", "api_v2:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
