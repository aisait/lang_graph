# =============================================================================
# JARVI 2.0.18 | Dockerfile.api CON INVALIDACIÓN DE CACHÉ
# =============================================================================

ARG CACHE_BUST=20260727_04

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libstdc++6 \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN echo "Cache bust version: ${CACHE_BUST}"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

RUN python -c "import langfuse, asyncpg, redis; print('✅ Dependencias críticas OK')"

COPY . .

# =============================================================================
# VERIFICACIÓN DE ARCHIVOS CORRECTOS
# =============================================================================
RUN grep -q "🔍 Respuesta final:" /app/api_new.py && echo "✅ api_new.py contiene diagnóstico" || echo "❌ api_new.py NO contiene diagnóstico"
RUN grep -q "ON CONFLICT (thread_id)" /app/db_client.py && echo "✅ db_client.py tiene UPSERT" || echo "❌ db_client.py antiguo"
RUN grep -q "===== JARVI API" /app/api_new.py && echo "✅ api_new.py tiene print de inicio" || echo "❌ api_new.py sin print"

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import langfuse, asyncpg, redis" || exit 1

EXPOSE 8080

# =============================================================================
# CMD con api_new:app (renombrado en repositorio)
# =============================================================================
CMD ["uvicorn", "api_new:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
