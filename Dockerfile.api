# =============================================================================
# JARVI 2.0.03 | Dockerfile.api CORREGIDO
# =============================================================================

FROM python:3.11-slim

# Dependencias del sistema (incluyendo librerías para binarios Rust/C)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libstdc++6 \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Instalación de dependencias Python
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --force-reinstall "langfuse>=4.0.0" "packaging==24.2"

# Verificación determinística (Fail-Fast)
RUN python -c "import langfuse, opentelemetry, asyncpg, redis; print('✅ Dependencias críticas OK')"

# Copiar código fuente
COPY . .

# Health check que verifica dependencias
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import langfuse, opentelemetry, asyncpg, redis" || exit 1

EXPOSE 8080
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
