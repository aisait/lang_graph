FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY debug_app.py .
COPY templates/ ./templates/
COPY vision.py .          # <--- Añadir esta línea
COPY audio.py .           # <--- Añadir esta línea
COPY vendedores.json .
COPY catalog_ontology.json .
ENV PORT=8080
EXPOSE 8080
CMD ["python", "debug_app.py"]
