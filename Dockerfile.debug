# =============================================================================
# Dockerfile.debug
# Imagen para el servicio de depuración CLI (Flask + Jinja2).
# Incluye soporte para procesamiento de imágenes (vision) y audio.
# Cumple con ISO/IEC 25010 (Fiabilidad) y 29119 (Pruebas).
# =============================================================================

FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código fuente
COPY debug_app.py .
COPY templates/ ./templates/
COPY vision.py .
COPY audio.py .
COPY vendedores.json .
COPY catalog_ontology.json .

# Puerto de escucha
ENV PORT=8080
EXPOSE 8080

# Comando de arranque
CMD ["python", "debug_app.py"]
