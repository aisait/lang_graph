# =============================================================================
# Dockerfile.debug - Cliente de depuración (Flask)
# Utiliza requirements-debug.txt para evitar conflictos de dependencias.
# =============================================================================

FROM python:3.11-slim

# Dependencias del sistema (necesarias para algunos paquetes)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libstdc++6 \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar requirements específico de debug
COPY requirements-debug.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-debug.txt

# Copiar todos los archivos necesarios para debug_app
COPY debug_app.py .
COPY templates/ ./templates/
COPY vision.py .
COPY audio.py .
COPY vendedores.json .
COPY catalog_ontology.json .

# Puerto de escucha
ENV PORT=8080
EXPOSE 8080

# Comando de arranque
CMD ["python", "debug_app.py"]
